# ---------- AUTOMATIC PROMPT OPTIMIZATION ----------

import json


class OptimizeRequest(BaseModel):
    prompt: str = Field(min_length=1, max_length=10000)
    objective: str = "balanced"
    min_accuracy: int = 70


async def generate_prompt_candidates(
    client: httpx.AsyncClient,
    baseline_prompt: str,
):
    """Generate candidates locally, with reliable fallback templates."""

    fallback_candidates = [
        (
            "Classify the sentiment of this product review. "
            "Return exactly one word: Positive or Negative. "
            "Positive means favorable sentiment; Negative means "
            "unfavorable sentiment.\n\nReview: {{input}}"
        ),
        (
            "Determine whether the following product review expresses "
            "positive or negative sentiment. Consider the overall meaning "
            "of the review. Output only Positive or Negative, with no "
            "explanation.\n\nReview: {{input}}"
        ),
        (
            "Task: sentiment classification.\n"
            "Read the product review and select one label.\n"
            "Positive = favorable opinion or satisfaction.\n"
            "Negative = unfavorable opinion or dissatisfaction.\n"
            "Output exactly one label: Positive or Negative.\n\n"
            "Review: {{input}}"
        ),
    ]

    generation_prompt = f"""
You are optimizing a prompt for product-review sentiment classification.

The input is a product review.
The output must be exactly one word: Positive or Negative.
Positive means favorable sentiment.
Negative means unfavorable sentiment.

Generate three different prompt templates for this exact task.
Every template must:
- Explicitly describe sentiment classification.
- Require exactly one output label: Positive or Negative.
- Include the literal placeholder {{{{input}}}}.
- Avoid unrelated topics, questions, and conversational replies.

Return valid JSON only, using this structure:
{{"candidates": ["template 1", "template 2", "template 3"]}}

Baseline:
{baseline_prompt}
"""

    generated = []

    try:
        response = await client.post(
            f"{OLLAMA_URL}/api/generate",
            json={
                "model": OLLAMA_MODEL,
                "prompt": generation_prompt,
                "stream": False,
                "format": "json",
                "options": {
                    "temperature": 0.3,
                    "num_predict": 400,
                },
            },
        )
        response.raise_for_status()

        raw_response = response.json().get("response", "")
        parsed = json.loads(raw_response)
        candidates = parsed.get("candidates", [])

        if isinstance(candidates, list):
            generated = candidates

    except (
        httpx.HTTPError,
        ValueError,
        KeyError,
        TypeError,
    ):
        # Use the predefined templates if generation or JSON parsing fails.
        generated = []

    cleaned = []
    seen = {baseline_prompt.strip()}

    # Try model-generated candidates first, then use fallbacks as needed.
    for candidate in generated + fallback_candidates:
        if not isinstance(candidate, str):
            continue

        candidate = candidate.strip()
        normalized = candidate.lower()

        valid = (
            candidate
            and "{{input}}" in candidate
            and candidate not in seen
            and "sentiment" in normalized
            and "positive" in normalized
            and "negative" in normalized
        )

        if valid:
            cleaned.append(candidate)
            seen.add(candidate)

        if len(cleaned) == 3:
            break

    if len(cleaned) < 3:
        raise ValueError(
            "Could not assemble three valid candidate prompts."
        )

    return cleaned

def rank_optimization_results(results, objective, min_accuracy=70):
    """Rank prompt results according to the selected objective."""

    for item in results:
        accuracy = float(item["accuracy_percent"])
        latency = float(item["average_latency_ms"])
        invalid = int(item["invalid_outputs"])

        item["eligible"] = accuracy >= min_accuracy

        # Lower latency is better; normalize it to a 0–1 score.
        item["speed_score"] = 1.0 / (1.0 + latency / 1000.0)

        # Higher accuracy and fewer invalid outputs are better.
        item["balanced_score"] = (
            0.70 * (accuracy / 100.0)
            + 0.20 * item["speed_score"]
            + 0.10 * (1.0 - invalid / max(item["total_examples"], 1))
        )

    if objective == "accuracy":
        results.sort(
            key=lambda item: (
                -item["accuracy_percent"],
                item["invalid_outputs"],
                item["average_latency_ms"],
            )
        )

    elif objective == "speed":
        eligible = [item for item in results if item["eligible"]]
        ineligible = [item for item in results if not item["eligible"]]

        eligible.sort(
            key=lambda item: (
                item["average_latency_ms"],
                -item["accuracy_percent"],
                item["invalid_outputs"],
            )
        )
        ineligible.sort(
            key=lambda item: (
                -item["accuracy_percent"],
                item["average_latency_ms"],
            )
        )
        results[:] = eligible + ineligible

    elif objective == "balanced":
        results.sort(
            key=lambda item: (
                -item["balanced_score"],
                -item["accuracy_percent"],
                item["average_latency_ms"],
            )
        )

    else:
        raise ValueError(
            "Objective must be accuracy, speed, or balanced."
        )

    for rank, item in enumerate(results, start=1):
        item["rank"] = rank

    return results
objective: str = "balanced"
min_accuracy: int = 70


@app.post("/api/optimize")
async def optimize_prompt(request: OptimizeRequest):
    try:
        async with httpx.AsyncClient(
            timeout=httpx.Timeout(600.0)
        ) as client:

            # Evaluate the baseline first.
            baseline_result = await evaluate_one_prompt(
                client, request.prompt
            )

            # Generate and evaluate candidates sequentially.
            candidates = await generate_prompt_candidates(
                client, request.prompt
            )

            results = [
                {
                    "name": "Baseline",
                    "prompt": request.prompt,
                    "is_baseline": True,
                    **baseline_result,
                }
            ]

            for index, candidate in enumerate(candidates, start=1):
                metrics = await evaluate_one_prompt(
                    client, candidate
                )

                results.append(
                    {
                        "name": f"Candidate {index}",
                        "prompt": candidate,
                        "is_baseline": False,
                        **metrics,
                    }
                )

            # Calculate scores and accuracy eligibility.
            for result in results:
                accuracy = float(result["accuracy_percent"])
                latency = float(result["average_latency_ms"])
                invalid = int(result["invalid_outputs"])
                total = max(
                    int(
                        result.get(
                            "total_examples",
                            len(EVALUATION_DATASET),
                        )
                    ),
                    1,
                )

                result["eligible"] = (
                    accuracy >= request.min_accuracy
                )
                result["speed_score"] = (
                    1.0 / (1.0 + latency / 1000.0)
                )
                result["balanced_score"] = (
                    0.70 * (accuracy / 100.0)
                    + 0.20 * result["speed_score"]
                    + 0.10 * (1.0 - invalid / total)
                )

            # Rank according to the selected objective.
            if request.objective == "accuracy":
                results.sort(
                    key=lambda result: (
                        -result["accuracy_percent"],
                        result["invalid_outputs"],
                        result["average_latency_ms"],
                    )
                )

            elif request.objective == "speed":
                results.sort(
                    key=lambda result: (
                        not result["eligible"],
                        (
                            result["average_latency_ms"]
                            if result["eligible"]
                            else -result["accuracy_percent"]
                        ),
                        -result["accuracy_percent"],
                        result["invalid_outputs"],
                    )
                )

            elif request.objective == "balanced":
                results.sort(
                    key=lambda result: (
                        -result["balanced_score"],
                        -result["accuracy_percent"],
                        result["average_latency_ms"],
                    )
                )

            else:
                raise HTTPException(
                    status_code=400,
                    detail=(
                        "Objective must be accuracy, speed, "
                        "or balanced."
                    ),
                )

            ranked_results = [
                {"rank": rank, **result}
                for rank, result in enumerate(results, start=1)
            ]

            return {
                "model": OLLAMA_MODEL,
                "dataset_size": len(EVALUATION_DATASET),
                "candidates_generated": len(candidates),
                "ranking_method": {
                "accuracy": (
                    "Accuracy descending, invalid outputs ascending, "
                    "average latency ascending"
                ),
                "speed": (
                    "Eligible prompts first, then average latency ascending; "
                    "ineligible prompts follow"
                ),
                "balanced": (
                    "Balanced score descending, then accuracy descending, "
                    "then average latency ascending"
                ),
            }[request.objective],
                "baseline": baseline_result,
                "best_candidate": ranked_results[0],
                "results": ranked_results,
                "warning": (
                    "Ranking uses the development dataset only. "
                    "Validate the selected prompt on unseen examples."
                ),
            }

    except httpx.TimeoutException:
        raise HTTPException(
            status_code=504,
            detail=(
                "Optimization timed out. The model may need more time. "
                "Try again or use shorter prompts."
            ),
        )
    except httpx.HTTPError:
        raise HTTPException(
            status_code=502,
            detail="Could not reach Ollama. Check that Ollama is running.",
        )
    except (ValueError, KeyError, TypeError, json.JSONDecodeError) as exc:
        raise HTTPException(
            status_code=502,
            detail=f"Could not generate valid prompt candidates: {exc}",
        )
