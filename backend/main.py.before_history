
import time

import httpx
from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel, Field

app = FastAPI(
    title="PromptLab API",
    description="Local prompt testing and experimentation",
    version="0.1.0",
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:5173"],
    allow_credentials=False,
    allow_methods=["*"],
    allow_headers=["*"],
)

OLLAMA_URL = "http://127.0.0.1:11434"
OLLAMA_MODEL = "llama3.2:1b"


class PromptRequest(BaseModel):
    prompt: str = Field(min_length=1, max_length=10000)


@app.get("/")
def home():
    return {
        "app": "PromptLab",
        "status": "running",
        "version": "0.1.0",
    }


@app.get("/api/health")
async def health():
    try:
        async with httpx.AsyncClient(timeout=5.0) as client:
            response = await client.get(
                f"{OLLAMA_URL}/api/tags"
            )
            response.raise_for_status()
            models = response.json().get("models", [])

        available = any(
            model.get("name", "").startswith(OLLAMA_MODEL)
            for model in models
        )

        return {
            "api": "ok",
            "ollama": "connected",
            "model": OLLAMA_MODEL,
            "model_available": available,
        }

    except (httpx.HTTPError, ValueError):
        return {
            "api": "ok",
            "ollama": "disconnected",
            "model": OLLAMA_MODEL,
            "model_available": False,
        }


@app.post("/api/run")
async def run_prompt(request: PromptRequest):
    start = time.perf_counter()

    try:
        async with httpx.AsyncClient(
            timeout=httpx.Timeout(180.0)
        ) as client:
            response = await client.post(
                f"{OLLAMA_URL}/api/generate",
                json={
                    "model": OLLAMA_MODEL,
                    "prompt": request.prompt,
                    "stream": False,
                },
            )
            response.raise_for_status()
            data = response.json()

        return {
            "prompt": request.prompt,
            "response": data.get("response", ""),
            "model": data.get("model", OLLAMA_MODEL),
            "latency_ms": round(
                (time.perf_counter() - start) * 1000, 2
            ),
            "prompt_tokens": data.get("prompt_eval_count"),
            "response_tokens": data.get("eval_count"),
        }

    except httpx.TimeoutException:
        raise HTTPException(
            status_code=504,
            detail="Model timed out. Try a shorter prompt.",
        )
    except httpx.HTTPError:
        raise HTTPException(
            status_code=502,
            detail=(
                "Could not reach Ollama. Ensure Ollama is "
                "running and llama3.2:1b is installed."
            ),
        )
    
class CompareRequest(BaseModel):
    test_input: str = Field(min_length=1, max_length=5000)
    prompt_a: str = Field(min_length=1, max_length=10000)
    prompt_b: str = Field(min_length=1, max_length=10000)


async def execute_comparison_prompt(
    client: httpx.AsyncClient,
    prompt_template: str,
    test_input: str,
):
    # Insert the shared test input wherever {{input}} appears.
    final_prompt = prompt_template.replace("{{input}}", test_input)
    start = time.perf_counter()

    response = await client.post(
        f"{OLLAMA_URL}/api/generate",
        json={
            "model": OLLAMA_MODEL,
            "prompt": final_prompt,
            "stream": False,
        },
    )
    response.raise_for_status()
    data = response.json()

    return {
        "prompt": final_prompt,
        "response": data.get("response", ""),
        "model": data.get("model", OLLAMA_MODEL),
        "latency_ms": round(
            (time.perf_counter() - start) * 1000, 2
        ),
        "prompt_tokens": data.get("prompt_eval_count"),
        "response_tokens": data.get("eval_count"),
    }


@app.post("/api/compare")
async def compare_prompts(request: CompareRequest):
    try:
        # Run sequentially to reduce memory pressure on your PC.
        async with httpx.AsyncClient(
            timeout=httpx.Timeout(180.0)
        ) as client:
            result_a = await execute_comparison_prompt(
                client, request.prompt_a, request.test_input
            )
            result_b = await execute_comparison_prompt(
                client, request.prompt_b, request.test_input
            )

        return {
            "model": OLLAMA_MODEL,
            "result_a": result_a,
            "result_b": result_b,
        }

    except httpx.TimeoutException:
        raise HTTPException(
            status_code=504,
            detail="The model timed out. Try shorter prompts or input.",
        )
    except httpx.HTTPError:
        raise HTTPException(
            status_code=502,
            detail="Could not reach Ollama. Check that Ollama is running.",
        )
    
